# --- 데이터베이스 (개발: SQLite) ---
DATABASE_URL="file:./dev.db"

# --- 기본 생성 경로 ---
# mock: 키/비용 없이 데모 (기본값). 수업에서는 mock 또는 무료 링크아웃만으로 충분.
DEFAULT_PROVIDER=mock

# --- 오디오 저장 드라이버: local | blob ---
STORAGE_DRIVER=local

# --- 선택: 선생님이 앱 안에서 직접 생성할 때만 필요 ---
# ElevenLabs Music (상업 라이선스가 깨끗한 API). 없으면 자동으로 "사용 불가" 처리.
ELEVENLABS_API_KEY=
# (Phase 2) Suno API
SUNO_API_KEY=

# --- 선택: Vercel Blob (배포 시 공유 반 갤러리) ---
BLOB_READ_WRITE_TOKEN=
